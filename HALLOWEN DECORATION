-- =========================================
-- FUNGSI UNTUK MENDAPATKAN INFORMASI WAKTU
-- =========================================
local function DapatkanInfoMenu()
    local jam = os.date("%H")
    local ucapan = ""
    local intJam = tonumber(jam) or 0
    
    if intJam >= 5 and intJam < 11 then
        ucapan = "Good Morning 🌅"
    elseif intJam >= 11 and intJam < 15 then
        ucapan = "Good Afternoon ☀️"
    elseif intJam >= 15 and intJam < 18 then
        ucapan = "Good Evening 🌆"
    else
        ucapan = "Good Night 🌙"
    end
    
    -- Format Hari Indonesia
    local hariInggris = os.date("%A")
    local hariIndo = {
        ["Sunday"] = "Minggu", ["Monday"] = "Senin", ["Tuesday"] = "Selasa",
        ["Wednesday"] = "Rabu", ["Thursday"] = "Kamis", ["Friday"] = "Jumat", ["Saturday"] = "Sabtu"
    }
    local hari = hariIndo[hariInggris] or hariInggris
    local tanggal = os.date("%d-%m-%Y")
    local waktuLengkap = os.date("%H:%M:%S")
    
    local header = "━━━━━━━━━━━━━━━━━━━━━━━━\n"
    header = header .. "☠️ " .. ucapan .. " HANZ ☠️\n"
    header = header .. "📅 " .. hari .. ", " .. tanggal .. "\n"
    header = header .. "⏰ Jam: " .. waktuLengkap .. "\n"
    header = header .. "🎮 GAME : TOWNSHIP\n"
    header = header .. "🛠️ DEV : HANZ\n"
    header = header .. "🎃 MENU : HALLOWEN DECORATION\n"
    header = header .. "━━━━━━━━━━━━━━━━━━━━━━━━"
    
    return header
end

